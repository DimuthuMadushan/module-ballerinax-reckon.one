        return self.clientEp->patch(resourcePath, request, headers);
    }

    # Gets what every transaction action has to offer for a contact.
    #
    # + bookId - The book's id
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - A transaction actions summary 
    remote isolated function getTransactionActionsSummary(string bookId, map<string|string[]> headers = {}, *GetTransactionActionsSummaryQueries queries) returns TransactionActionsSummary|error {
        string resourcePath = string `/${getEncodedUri(bookId)}/transactionActions/summary`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }

    # Gets what one transaction action has to offer for a contact.
    #
    # + bookId - The book's id
    # + actionType - The action to read
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - The details of the `InvoiceFrequentlyUsed` action. or The details of the `InvoiceRecentTransactions` action 
    remote isolated function listTransactionActionDetails(string bookId, TransactionActionType actionType, map<string|string[]> headers = {}, *ListTransactionActionDetailsQueries queries) returns json|error {
        string resourcePath = string `/${getEncodedUri(bookId)}/transactionActions/${getEncodedUri(actionType)}/details`;
        map<Encoding> queryParamEncoding = {"rowType": {style: FORM, explode: true}, "itemTypes": {style: FORM, explode: true}};
        resourcePath = resourcePath + check getPathForQueryParam(queries, queryParamEncoding);
        return self.clientEp->get(resourcePath, headers);
    }

    # Gets a list of users.
    #
    # + bookId - The book's id
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - A paged list of users for the specified book 
    remote isolated function listUsers(string bookId, map<string|string[]> headers = {}, *ListUsersQueries queries) returns Users|error {
        string resourcePath = string `/${getEncodedUri(bookId)}/users`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }

    # Updates a user's roles.
    #
    # + bookId - The book's id
    # + userId - The user's id or portal id
    # + headers - Headers to be sent with the request 
    # + payload - List of user's roles 
    # + return - The result of the update 
    remote isolated function updateUserRoles(string bookId, string userId, UserRoles payload, map<string|string[]> headers = {}) returns error? {
        string resourcePath = string `/${getEncodedUri(bookId)}/users/${getEncodedUri(userId)}`;
        http:Request request = new;
        json jsonBody = jsondata:toJson(payload);
        request.setPayload(jsonBody, "application/json");
        return self.clientEp->put(resourcePath, request, headers);
    }
}
