# The parameters for the timesheet report
public type TimesheetReportParameters record {|
    # The period
    TimesheetReportPeriod? period = "AllDates";
    # The report's orientation
    ReportOrientation? orientation = "Portrait";
    # A list of project IDs to include in the report.
    # If omitted, all projects will be included
    string[]? projects?;
    # A list of columns to include in the report.
    # If omitted, all columns will be returned
    TimesheetReportColumn[]? columns?;
    # The 'to' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? toDate?;
    # The data grouping for the report
    TimesheetReportGroupBy groupBy = "None";
    # A list of service item IDs to include in the report.
    # If omitted, all service items will be included
    string[]? serviceItems?;
    # An authentication token. Note that this is not required if it is supplied via the HTTP `Authorize` header
    string? token?;
    # The 'from' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? fromDate?;
    # A list of classification IDs to include in the report.
    # If omitted, all classifications will be included
    string[]? classifications?;
    # The timesheet statuses to include in the report.
    # If omitted, all timesheet statuses will be included
    TimesheetReportTimesheetStatus[]? timesheetStatus?;
    # A list of customer IDs to include in the report.
    # If omitted, all customers will be included
    string[]? customers?;
    # A list of employee IDs to include in the report.
    # If omitted, all employees will be included
    string[]? employees?;
    # The billing statuses to include in the report.
    # If omitted, all billing statuses will be included
    TimesheetReportBillingStatus[]? status?;
|};

