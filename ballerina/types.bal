# A sales order
public type SalesOrder record {|
    # The template used to print or email the sales order
    TemplateRef? template?;
    # Notes related to the sales order
    string? notes?;
    # The date the sales order was last modified. UTC date-time in ISO-8601 format
    string? lastModifiedDateTime?;
    # Identifies if the sales order has linked invoices
    boolean hasLinkedInvoices?;
    # Document attachments related to the sales order
    DocumentAttachment[]? attachments?;
    # The amount tax status of the amounts in the sales order
    AmountTaxStatus amountTaxStatus?;
    # The project
    ProjectRef? project?;
    # The date the sales order was created. UTC date-time in ISO-8601 format
    string? createdDateTime?;
    # The sales order reference
    string? reference?;
    # The individual items that make up the sales order
    SalesOrderLineItem[] lineItems?;
    # The sales order's unique id
    string id?;
    # The sales order's number
    string salesOrderNumber?;
    # The payment details ("how to pay") shown on the sales order
    string? paymentDetails?;
    # The customer's purchase order number
    string? customerPurchaseOrderNumber?;
    # The outstanding balance of the sales order
    decimal totalBalance?;
    # The last email store id the sales order got sent
    string? lastEmailStoreId?;
    # The classification
    ClassificationRef? classification?;
    # The total amount of the sales order
    decimal totalAmount?;
    # Whether the sales order has been emailed to the customer
    EmailStatus emailStatus?;
    # The date of the sales order
    string salesOrderDate?;
    # The last date and time the sales order got sent
    string? sendDateTimeUTC?;
    # The address that the sales order was sent to
    Address? billingAddress?;
    # The total tax amount of the sales order
    decimal totalTaxAmount?;
    # The amount of the sales order that has been invoiced (total amount less outstanding balance)
    decimal totalInvoiced?;
    # The customer that owns the sales order
    ContactRef customer?;
    # The status of the sales order
    SalesOrderStatus status?;
|};

