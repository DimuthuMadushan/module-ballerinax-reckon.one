# The parameters for the Payroll Transactions Summary report
public type PayrollTransactionsSummaryReportParameters record {|
    # The 'from' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? fromDate?;
    # The period
    PayrollTransactionsSummaryReportPeriod? period = "AllDates";
    # The report's orientation.
    # Ignored for JSON report format
    ReportOrientation? orientation = "Portrait";
    # A list of columns to include in the report.
    # If omitted, all columns will be returned
    PayrollTransactionsSummaryReportColumn[]? columns?;
    # The 'to' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? toDate?;
    # A list of pay run IDs to include in the report.
    # If omitted, all pay runs will be included
    string[]? payruns?;
    # An authentication token. Note that this is not required if it is supplied via the HTTP `Authorize` header
    string? token?;
|};

