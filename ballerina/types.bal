    BillLineItemItemDetailsInput? itemDetails?;
    # The description of the line
    string? description?;
    # The line number
    int:Signed32? lineNumber?;
    # The tax amount
    decimal? taxAmount?;
    # The classification full name
    string? classification?;
|};

