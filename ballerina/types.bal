    string claimDate;
    # The amount tax status of the amounts in the invoice
    AmountTaxStatus amountTaxStatus;
    # The project that the expense claim relates to
    string? project?;
    # The employee who lodged the expense claim
    @constraint:String {minLength: 1}
    string employee;
    # The classification
    string? classification?;
    # The customer that the expense claim relates to
    string? customer?;
    # The status of the expense claim
    ExpenseClaimStatus? status = "Draft";
|};

