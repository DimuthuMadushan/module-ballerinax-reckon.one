# A recurring transaction template, as shown in the recurring transactions list. Generic across
# all transaction types - does not include the type-specific template body (line items,
# supplier/customer details, etc.); use the get-by-id endpoint for that. Backed by the same
# external list service the Kendo recurring transactions grid uses, so Status and
# Frequency are the display-ready strings it returns rather than structured enums;
# TransactionType is parsed into the same enum POST/PUT use, for consistency
public type RecurringTransactionListItem record {|
    # The transaction amount
    decimal amount?;
    # The id of the contact (customer or supplier) this template is for. Null if the template has no contact,
    # e.g. a journal
    string? contactId?;
    # The date of the last occurrence, when the schedule ends on a specific date
    string? endDate?;
    # The name of the contact (customer or supplier) this template is for
    string? contactName?;
    # The id of the recurring transaction group the template is in. Null if it is not in a group
    string? groupId?;
    # The date of the next occurrence
    string? nextTransactionDate?;
    # How often each occurrence is generated
    string? frequency?;
    # The type of transaction this template generates. Null if the underlying list service
    # returns a type outside the five POST/PUT support (e.g. legacy credit note/bill credit data)
    RecurringTransactionType? transactionType?;
    # The transaction reference
    string? reference?;
    # Whether occurrences are generated on a schedule or created manually. Null if the underlying list
    # service returns a schedule type this API does not recognise
    RecurringScheduleType? recurringType?;
    # The name of the recurring transaction group the template is in. Null if it is not in a group, or if
    # recurring transaction groups are not available to the user
    string? groupName?;
    # The recurring template's name
    string? name?;
    # The recurring template's unique id
    string id?;
    # The date of the first occurrence
    string? startDate?;
    # The recurring template's status
    string? status?;
|};

# Lineitems of a superstream
public type SuperstreamLineItem record {|
    # The rate in percent format if used
    decimal ratePercent?;
    # The amount of super payment made for this line item
    decimal amount?;
    # The name and unique id of the the superfund provider
    SuperfundProviderRef? superFundProvider?;
    # The isDirty flag for the superstream line item. 
    boolean incompleteData?;
    # The rate in dollar format if used. 
    decimal rateAmount?;
    # The name and unique id of the product of the super fund provider
    SuperfundProviderProductRef? superFundProviderProduct?;
    # The details of the employee in the superstream. 
    SuperstreamEmployee? employee?;
    # The name and unique id of the payrun that includes the superfund details. 
    PayRunRef? payrun?;
    # The line item's unique id
    string payrunSuperLineId?;
    # The name and unique id of the company superfund organisation. 
    SuperfundRef? superfund?;
    # The members number from the superfund
    string? memberNumber?;
    # The date the superfund was paid. 
    string? paymentDate?;
    # The super type
    SuperType superType?;
|};

