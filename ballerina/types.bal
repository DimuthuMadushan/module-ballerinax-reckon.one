# Details of a payment to create or update
public type PaymentPut record {|
    # The accounts payable ledger account.
    # _Note:_ It is not currently possible to create multiple Accounts Payable accounts so this field is read-only and will be ignored
    string? accountsPayableLedgerAccount?;
    # Notes related to the payment
    string? notes?;
    # Internal Notes related to the payment
    string? internalNotes?;
    # The classification
    string? classification?;
    # The payment reference
    string? reference?;
    # The individual items that make up the payment
    PaymentLineItemPut[]? lineItems?;
    # The total amount of the payment applied
    decimal totalAmount;
    # The payments's reconciliation status.
    # Note that this can only be initially set to Cleared or Uncleared and that it can only be updated via a bank reconciliation
    ReconciliationStatus? reconciliationStatus = "Uncleared";
    # The id or name of the bank/cash/credit account where the money was received
    string? ledgerAccount?;
    # The supplier that is being paid
    @constraint:String {minLength: 1}
    string supplier;
    # The id or name of the payment method used
    string? paymentMethod?;
    # The date of the payment
    @constraint:String {minLength: 1}
    string paymentDate;
    # Details of transactions that the payment should be allocated to
    PaymentTransactionLinkInput[]? transactionLinks?;
|};

