# A recurring transaction to create over REST. One endpoint accepts all five recurring
# transaction types; Template's shape depends on TransactionType
# and is resolved by the helper rather than by model binding
public type CreateRecurringTransactionRequest record {|
    # The type of transaction this template generates. Determines how Template
    # is interpreted
    RecurringTransactionType transactionType?;
    # The transaction-type-specific template. Its shape is one of five concrete types
    # (bill, invoice, journal, payment or receipt), selected by TransactionType
    anydata? template?;
    # The schedule that determines when each occurrence is generated. Required unless
    # RecurringScheduleType is Unscheduled, in which case it is optional and,
    # when supplied, only its timing fields are used to compute reminders
    RecurringScheduleInput? schedule?;
    # Whether each generated transaction should be automatically emailed. Only applies to
    # Bill and Invoice; ignored for Journal, Payment and Receipt
    boolean autoSendEmail?;
    # The date to send the email on, when AutoSendEmail is true. Only applies to Bill
    string? sendDate?;
    # The recurring template's name
    string? name?;
    # The type of schedule for the recurring transaction. Defaults to Scheduled
    RecurringScheduleType recurringScheduleType?;
    # Options for the recurring transaction
    RecurringTransOptionsInput? transOptions?;
    # The recurring template's status
    RecurringTemplateStatus status?;
|};

# A book's time entry settings
public type TimeEntrySettings record {|
    # Indicates whether an imported time line's Service date is set from its timesheet entry date
    boolean setInvoiceServiceDateToTimeEntryDate?;
    # The start time of a week. 
    TimeStartOfWeek firstDayOfWeek?;
    # The transfer billable time settings
    TransferBillableTimeSettings transferBillableTimeAs?;
    # Indicates whether time entry approval is enabled
    boolean approvalEnabled?;
|};

