# A recurring transaction template, including its type-specific body. Returned by the REST
# get-by-id endpoint - a REST-only type, not part of the GraphQL schema (unlike the base
# RecurringTransactionTemplate, which the skip/status GraphQL mutations also return)
public type RecurringTransactionDetail record {|
    # Recurring type of the template, which is used to determine the type of transaction that will be created from this template
    RecurringScheduleType recurringType?;
    # The type of transaction this template generates. Determines Template's shape
    RecurringTransactionType transactionType?;
    # The transaction-type-specific template. For Invoice and Journal, the same rich shape the
    # GraphQL recurring-transaction queries return. For Bill, Payment and Receipt, a dedicated rich
    # read shape (RecurringBillTemplate, RecurringPaymentTemplate,
    # RecurringReceiptTemplate) with every id resolved to a named reference
    anydata? template?;
    # The schedule that determines when each occurrence is generated, or null for an
    # unscheduled template with no reminder
    RecurringSchedule? schedule?;
    # The documents attached to the recurring template. Only recurring invoices have an
    # attachments experience, so the GraphQL schema exposes this on
    # RecurringInvoiceTemplate alone, via RecurringInvoiceTemplateGraphql
    DocumentAttachment[]? attachments?;
    # The recurring template's name
    string name?;
    # The recurring template's unique id
    string id?;
    # The recurring template's status
    RecurringTemplateStatus status?;
    # The group the template is assigned to, or null when it is not in a group
    RecurringTransactionGroupRef? group?;
|};

# A response that contains the resource's id and display name
public type IdNameResponse record {|
    # The resource's display name
    string? name?;
    # The resource's id
    string id?;
|};

# Details of a customer to create or update
public type CustomerInput record {|
    # List of addresses
    AddressInput[]? addresses?;
    # Notes for the organisation
    string? notes?;
    # List of custom fields
    OrganisationCustomFieldValueInput[]? customFields?;
    # This applies to NZBN number
    string? businessNumber?;
    # List of electronic addresses
    ElectronicAddressInput[]? electronicAddresses?;
    # The organisation's branch
    string? branch?;
    # List of phone numbers
    PhoneNumberInput[]? phoneNumbers?;
    # The organisation's name
    string? organisationName?;
    # The customer's transaction password details
    TransactionPasswordInput? transactionPassword?;
    # Indicates that the invoice reminder has been excluded for invoices
    boolean? excludeFromInvoiceReminders?;
    # The organisation's display name
    @constraint:String {maxLength: 100, minLength: 1}
    string name;
    # The customer's credit limit
    decimal? creditLimit?;
    # The organisation's business number 2
    string? businessNumber2?;
    # The organisation's entity types
    EntityType? entityTypes?;
    # The organisation's business number 1
    string? businessNumber1?;
    # The customer's payment term id
    string? paymentTerms?;
    # The status of the organisation. (Active/Inactive)
    OrganisationStatus? status = "Active";
|};

# Details of an electronic address type to create or update
public type ElectronicAddressTypeInput record {|
    # The type's name
    @constraint:String {maxLength: 25, minLength: 1}
    string name;
    # The type's description
    string? description?;
    # The type's status
    TypeStatus? status = "Active";
|};

# Details of an invoice to create
public type InvoiceInput record {|
    # The accounts receivable ledger account.
    # _Note:_ It is not currently possible to create multiple Accounts Receivable accounts so this field is read-only and will be ignored
    string? accountsReceivableLedgerAccount?;
    # The template used to print or email the invoice
    string? template?;
    # Notes related to the invoice
    string? notes?;
    # The amount tax status of the amounts in the invoice
    AmountTaxStatus amountTaxStatus;
    # List of custom fields
    SalesTransactionCustomFieldValueInput[]? customFields?;
    # The date payment is due by
    string? dueDate?;
    # The invoice discount amount
    decimal? invoiceDiscountAmount?;
    # If true, this invoice should be included in daily reminder checks
    boolean? includeInInvoiceReminders?;
    # The date of the invoice
    @constraint:String {minLength: 1}
    string invoiceDate;
    # The classification
    string? classification?;
    # The invoice discount percentage
    decimal? invoiceDiscountPercent?;
    # The invoice reference
    string? reference?;
    # The individual items that make up the invoice.
    # Note that the maximum items is 200
    InvoiceLineItemInput[] lineItems;
    # The purchase order number
    string? purchaseOrderNumber?;
    # A user defined invoice number.
    # If not provided, the next available invoice number will be used
    string? invoiceNumber?;
    # Details of how to pay the invoice
    string? paymentDetails?;
    # The transaction links for the invoice
    InvoiceHeaderTransactionLink[]? transactionLinks?;
    # Payment terms
    string? paymentTerms?;
    # The customer that is being invoiced
    @constraint:String {minLength: 1}
    string customer;
|};

