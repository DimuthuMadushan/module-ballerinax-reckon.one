# Details of an account used on an supplier credit note line item
public type SupplierCreditNoteLineItemAccountDetails record {|
    # The amount
    decimal? amount?;
    # The quantity of items for this line
    decimal? quantity?;
    # The id and full name of the ledger account that the line relates to
    LedgerAccountRef ledgerAccount?;
|};

# Represents the Queries record for the operation: listTimeEntries
public type ListTimeEntriesQueries record {
    # The number of time entries per page
    int:Signed32? perPage = 0;
    # The page to retrieve
    int:Signed32 page = 1;
};

# An estimate line item
public type EstimateLineItemPut record {|
    # The id or name of the applicate tax
    string? taxRate?;
    # The value of any markup as a percentage. MarkupAmount and MarkupPercent are mutually exclusive
    decimal? markupPercent?;
    # The id or full name of the project that the line item relates to
    string? project?;
    # Details of an item used on an estimate line item
    EstimateLineItemItemDetailsInput itemDetails;
    # lineId of the line item
    string? lineId?;
    # The line number
    int:Signed32 lineNumber;
    # The value of any markup as an amount. MarkupAmount and MarkupPercent are mutually exclusive
    decimal? markupAmount?;
    # The tax amount
    decimal? taxAmount?;
    # The classification
    string? classification?;
|};

public type FrequentlyUsedRowType "Unknown"|"Item"|"LedgerAccount";

# Payment to include in bank payment
public type BankPaymentLineItemUpdateInput record {|
    # Id of payment to include in bank payment
    string paymentId?;
    # Id of bank payment line item
    string? lineId?;
|};

# Details of a default super fund
public type DefaultSuperfundInput record {|
    # The id or name of the super fund
    @constraint:String {minLength: 1}
    string fund;
    # The id or name of the super fund product
    string? fundProduct?;
|};

# An estimate line item
public type EstimateLineItem record {|
    # The tax rate
    TaxRateRef? taxRate?;
    # Line's total amount
    decimal amount?;
    # The value of any markup as a percentage. MarkupAmount and MarkupPercent are mutually exclusive
    decimal? markupPercent?;
    # Whether the tax amount has been modified
    boolean? taxIsModified?;
    # The line item's unique id
    string lineId?;
    # The id and full name of the project that the line item relates to
    ProjectRef? project?;
    # Details of an item used on an estimate line item
    EstimateLineItemItemDetails? itemDetails?;
    # The line number
    int:Signed32 lineNumber?;
    # The value of any markup as an amount. MarkupAmount and MarkupPercent are mutually exclusive
    decimal? markupAmount?;
    # The tax amount
    decimal? taxAmount?;
    # The classification
    ClassificationRef? classification?;
|};

# The payroll settings' ledgal contact details
public type PayrollLegalContact record {|
    # The first name of legal contact
    string? firstName?;
    # The last name of legal contact
    string? lastName?;
    # List of electronic addresses
    BookElectronicAddress[]? electronicAddresses?;
    # The legal contact's title
    string? title?;
    # List of phone numbers
    BookPhoneNumber[]? phoneNumbers?;
|};

# Details of a transaction to link to a receipt
public type ReceiptTransactionLinkInput record {|
    # The type of linked transaction
    LinkedTransactionType transactionType;
    # The total amount of the transaction
    decimal transactionAmount;
    # The unique id of the linked transaction
    @constraint:String {minLength: 1}
    string transactionId;
|};

# OAuth2 Refresh Token Grant Configs
public type OAuth2RefreshTokenGrantConfig record {|
    *http:OAuth2RefreshTokenGrantConfig;
    # Refresh URL
    string refreshUrl = "https://identity.reckon.com/connect/token";
|};

# Details of an expense claim to update
public type ExpenseClaimPut record {|
    # The reference entered by the employee
    string? reference?;
    # The individual items that make up the expense claim
    ExpenseClaimLineItemPut[]? lineItems?;
    # The notes entered by the employee
