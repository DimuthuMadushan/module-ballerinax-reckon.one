    # The email subject
    string subject?;
    # The number of the document that the email relates to
    string documentNumber?;
    # A list of "CC" addresses
    string[]? ccAddresses?;
    # A list of "BCC" addresses
    string[]? bccAddresses?;
    # A list of "To" addresses
    string[] toAddresses?;
    # The email body
    string body?;
|};

# Bank account details
public type LedgerAccountBankUpdate record {|
    # The name of the account holder
    string? bankAccountName?;
    # The APCA number to identify the payer
    string? payerIdentifier?;
    # When the bank account was opened
    string? dateOpened?;
    # AU: BSB number (exactly 6 characters). UK: Sort Code. NZ: Bank number (exactly 2 characters)
    string? bankBranchNumber?;
    # Whether to include a balancing transaction
    boolean includeBalancingTransaction;
    # The date when transactions are locked.
    # Transactions dated on or before this date cannot be amended
    string? lockoffDate?;
    # AU: not used. NZ: Branch number (max 4 characters)
    string? bankAccountNumberExtra?;
    # Account number. NZ: max 7 characters
    string? bankAccountNumber?;
    # When the account was closed
    string? closedAsOfDate?;
    # The id of the financial institution
    string? financialInstitution?;
    # The bank account's opening balance
    decimal? openingBalance?;
    # AU: not used. NZ: Suffix (max 3 characters)
    string? bankAccountNumberSuffix?;
|};

# Role permissions for employees
public type RolePermissionsForEmployees record {|
    # Whether the role has permission to view
    boolean view?;
    # Whether the role has permission to edit/update/modify
    boolean edit?;
    # Whether the role has permission to create
    boolean create?;
    # Whether the role can view own employee details
    boolean viewOwnDetails?;
    # Whether the role can manage payroll employee's details
    boolean managePayrollEmployeeDetails?;
    # Whether the role has permission to delete
    boolean delete?;
    # Whether the role can edit own employee details
    boolean editOwnDetails?;
|};

# Details of an account used on an estimate line item
public type EstimateLineItemItemDetailsInput record {|
    # The id or full name of the item that the line relates to
    string? item?;
    # The quantity sold
    decimal? quantity?;
    # The price of each item
    decimal? price?;
    # Description of line item
    string? description?;
|};

# Payroll Leave Balances and Accrual report pay item group
public type PayrollLeaveBalancesAndAccrualValuePayItemGroup record {|
    # The pay item
    PayItemRef2 payItem?;
    # Group details
    PayrollLeaveBalancesAndAccrualValueEmployeeTransaction[] list?;
    # Totals for the group
    PayrollLeaveBalancesAndAccrualValueReportTotals groupTotals?;
|};

# A book's estimate settings
public type EstimateSettings record {|
    # The default payment notes for estimates
    string? paymentNotes?;
    # The estimate prefix
    string? prefix?;
    # The number of days until an estimate expires
    int:Signed32? estimateExpiryDays?;
    # The default estimate template
    TemplateRef defaultTemplate?;
    # Indicates whether estimates are enabled
    boolean estimatesEnabled?;
    # The default terms and conditions for estimates
    string? termsAndConditions?;
|};

# A payment term's due date
public type PaymentTermDueDate record {|
    # The due day of the payment term
    string dueDate?;
|};

# A superfund’s details
public type SelfManagedSuperfund record {|
    # The electronic address for service
    string electronicServiceAddress?;
    # The self-managed super fund’s (SMSF) name
    string fundName?;
|};

# Details of an item used on a purchase order line item
public type PurchaseOrderLineItemItemDetails record {|
    # The id and full name of the item that the line relates to
    ItemRef item?;
    # The total amount for the line item
    decimal? amount?;
    # The quantity sold
    decimal? quantity?;
    # The price of each item
    decimal? price?;
|};

# Represents the Queries record for the operation: addExpenseClaimAttachment
public type AddExpenseClaimAttachmentQueries record {
    # The name of the file when passing a single document in the body of the request
    string? fileName?;
};

# Details of a time entry to create or update
public type TimeEntryInput record {|
    # The id or full name of the item that the time entry relates to.
    # Note that the full name includes the name(s) of any parent item(s) separated by colons
    string? item?;
    # Notes related to the time entry
    string? notes?;
    # The id or full name of the project on which the time was spent on.
    # Note that the full name includes the name(s) of any parent project(s) separated by colons
    string? project?;
    # Details of the time spent
    TimeDetailsInput time;
    # The id or name of the employee that spent the time
    @constraint:String {minLength: 1}
    string employee;
    # The id or name of the classification
    string? classification?;
    # The id or full name of the payroll pay item that the time entry relates to
    string? payrollItem?;
    # Whether the time can be billed to a customer
    boolean? billable?;
    # Date of the time entry
    @constraint:String {minLength: 1}
    string timeEntryDate;
    # Reason why time entry approval was declined.
    # Note that this cannot be set via POST
    string? declineReason?;
    # The id or name of the customer for whom the time was spent on
    string? customer?;
|};

# Pay template earning
public type PayTemplateEarning record {|
    # Pay item earning
    PayItemRef? earningsItem?;
    # Pay template earning classifications
    PayTemplateEarningClassification[]? classifications?;
    # Rate fulltime
    decimal? rateFullTime?;
    # Rate casual
    decimal? rateCasual?;
    # Pay template earning id
    string id?;
|};

# Details of a CreditNote line item to update
public type CreditNoteLineItemPut record {|
    # The tax rate
    string? taxRate?;
    # Whether the tax amount has been modified
    boolean? taxIsModified?;
    # Details of an account used on an invoice line item.
    # This must be omitted if `itemDetails` have been provided
    CreditNoteLineItemAccountDetailsInput? accountDetails?;
    # The id or full name of the project that the line item relates to.
    # Note that the full name includes the name(s) of any parent project(s) separated by colons
    string? project?;
    # Details of an item used on an invoice line item.
    # This must be omitted if `accountDetails` have been provided
    CreditNoteLineItemItemDetailsInput? itemDetails?;
    # The description of the line
    string? description?;
    # lineId of the line item
    string? lineId?;
    # The line number
    int:Signed32 lineNumber;
    # The tax amount
    decimal? taxAmount?;
    # The classification
    string? classification?;
|};

# Role permissions for a report
public type RolePermissionsForReport record {|
    # Whether the role has permission to view the report
    boolean view?;
    # Whether the role has permission to export the report
    boolean export?;
|};

# Credit account details
public type LedgerAccountCreditUpdate record {|
    # When the credit account was opened
    string? dateOpened?;
    # The date when transactions are locked.
    # Transactions dated on or before this date cannot be amended
    string? lockoffDate?;
    # When the account was closed
    string? closedAsOfDate?;
    # The credit account's opening balance
    decimal? openingBalance?;
|};

# Details of a contact to create or update within an existing organisation
public type LinkedContactInput record {|
    # List of addresses
    AddressInput[]? addresses?;
    # Notes for the contact
    string? notes?;
    # The contact's display name
    @constraint:String {maxLength: 100, minLength: 1}
    string name;
    # List of electronic addresses
    ElectronicAddressInput[]? electronicAddresses?;
    # The salutation to use in communications
    string? salutation?;
    # The contact's position
    string? position?;
    # The contact's department
    string? department?;
    # List of phone numbers
    PhoneNumberInput[]? phoneNumbers?;
    # The contact's status
    ContactStatus? status = "Active";
|};

# A transaction linked to another transaction
public type SupplierCreditNoteTransactionLinkPatch record {|
    # The total amount of the transaction. 
    decimal transactionAmount;
|};

# Details of an address type to create or update
public type AddressTypePatch record {|
    # The type's name
    string? name?;
    # The type's description
    string? description?;
    # The type's status
    TypeStatus? status?;
|};

# Enum representing the different types of entities that can have audit history records
public type AuditHistoryTypeEnum "NotSet"|"Invoice"|"Estimate"|"Receipt"|"ChargeableItem"|"Project"|"Timesheets"|"Expenses"|"TaxPreferences"|"TaxAgency"|"TaxCodeAndTaxGroup"|"Bill"|"BillCredit"|"CreditNote"|"Payment"|"Journal"|"Cashbook"|"AccountingCategory"|"SalesPreferences"|"PurchasePreferences"|"Banking"|"MoneyTransfer"|"ActivityStatement"|"AutoCodeRule"|"ExpenseItem"|"ExpensePreferences"|"InvoicingBillableTimeOptions"|"InvoicingBillableExpenseOptions"|"Terms"|"VatReturn"|"Role"|"HmrcCredentials"|"BankPayment"|"PayItem"|"LeaveItem"|"PaySchedule"|"SuperFund"|"PayrollSettings"|"Ytd"|"EmployeeTax"|"EmployeeEmployment"|"EmployeeFinancial"|"EmployeePersonal"|"EmployeeLeave"|"PayRunCreation"|"TPARReport"|"PaymentServices"|"Classification"|"StatementPreferences"|"RecurringTransaction"|"BookSettings"|"SingleTouchPayroll"|"BankReconciliation"|"TimePreferences"|"ElectronicAddressType"|"AddressType"|"ContactNumberType"|"RemittanceAdvice"|"DepartmentManager"|"DepartmentEmployee"|"SuperStream"|"BookCustomField"|"CustomerSupplierCustomField"|"SalesTransactionCustomField"|"Items"|"ItemCustomField"|"StockAdjustment"|"PurchaseOrder"|"LeaveRequest";

public type BeginBankReconciliationResponse record {|
    boolean success?;
    string? userErrorCode?;
    int:Signed32? errorCode?;
    string? fullMessage?;
    string reconciliationId?;
    string? message?;
|};

# The parameters for the Super Transactions report
public type SuperTransactionsReportParameters record {|
    # The 'from' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? fromDate?;
    # The period
    SuperTransactionsReportPeriod? period = "AllDates";
    # The report's orientation
    ReportOrientation? orientation = "Portrait";
    # A list of columns to include in the report.
    # If omitted, all columns will be returned
    SuperTransactionsReportColumn[]? columns?;
    # The 'to' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? toDate?;
    # A list of superfund IDs to include in the report.
    # If omitted, all superfunds will be included
    string[]? superfunds?;
    # A list of employee IDs to include in the report.
    # If omitted, all employees will be included
    string[]? employees?;
    # A list of pay run IDs to include in the report.
    # If omitted, all pay runs will be included
    string[]? payruns?;
    # An authentication token. Note that this is not required if it is supplied via the HTTP `Authorize` header
    string? token?;
|};

# A state
public type State record {|
    # The state's abbreviated code. 
    string? code?;
    # The state's full name. 
    string? name?;
|};

# Details of an invoice to patch
public type PurchaseOrderLineItemPatch record {|
    # The tax rate
    string? taxRate?;
    # The supplier for the purchase order
    string? supplier?;
    # Details of an item used on an invoice line item.
    # This must be omitted if `accountDetails` have been provided
    PurchaseOrderLineItemItemDetailsPatch? itemDetails?;
    # The description of the line
    string? description?;
    # The project
    string? project?;
    # The line number
    int:Signed32? lineNumber?;
    # The tax amount
    decimal? taxAmount?;
    # The classification
    string? classification?;
    # Identify if a line item is a full width description
    boolean isFullWidthDescription?;
|};

# The GST reporting period
public type GstReportingPeriodType "StartsFromJan"|"StartsFromFeb"|"StartsFromMar"|"StartsFromApr"|"StartsFromMay"|"StartsFromJun";

# Details for colour of template
public type InvoiceTemplateFeatureColour record {|
    # The colour
    string? colour?;
    # Name for this colour
    string? name?;
    # Database ID for this colour
    int:Signed32 id?;
|};

# A bills summary
public type BillsSummary record {|
    # Total bills count
    int:Signed32 totalBillCount?;
    # Unpaid bills amount
    decimal unpaidBillAmount?;
    # Unpaid bills count
    int:Signed32 unpaidBillCount?;
    # Overdue bills count
    int:Signed32 overdueBillCount?;
    # Overdue bills amount
    decimal overdueBillAmount?;
|};

# Details of the footer of a purchase order template
public type PurchaseOrderTemplateFooter record {|
    # Is Note included in the template's footer
    boolean note?;
    # The default text for Notes
    string? noteDefaultValue?;
    # Is Balance included in the template's footer
    boolean balance?;
    # Is Subtotal included in the template's footer
    boolean subtotal?;
    # Is TotalExcludingTax included in the template's footer
    boolean totalExcludingTax?;
    # The HTML for terms and conditions
    string? termsAndConditionsValue?;
    # Is TaxAmount included in the template's footer
    boolean taxAmount?;
    # Are Terms and Conditions included in the template's footer
    boolean termsAndConditions?;
|};

# The type of transaction
public type TransactionType "Sale"|"Purchase"|"Transfer";

# Details of a project to create or update
public type ProjectInput record {|
    # The parent project
    string? parentProject?;
    # Suppliers linked to the project
    ProjectSupplierInput[]? suppliers?;
    # The date the project ends
    string? endDate?;
    # The amount tax status of the amounts in the project.
    # If this field is omitted, the value from the book's tax settings will be used
    ProjectAmountTaxStatus? amountTaxStatus?;
    # The billing method for the project
    ProjectBillingMethodEnum billingMethod?;
    # Name of project
    @constraint:String {maxLength: 300, minLength: 1}
    string name;
    # A description of the project
    string? description?;
    # Customers linked to the project
    ProjectCustomerInput[]? customers?;
    # Items used in the project
    ProjectItemInput[]? items?;
    # The date the project starts
    string? startDate?;
    # Status of project
    ProjectStatus? status = "Active";
|};

