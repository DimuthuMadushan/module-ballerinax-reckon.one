# Details of an item to create
public type ItemInput record {|
    # The item type
    ItemType? itemType = "Product";
    # Details for the item when it is sold
    ItemUseInput? sale?;
    # The amount tax status of the amounts in the item.
    # This determines whether item prices include or exclude tax (i.e. gross or net)
    ItemAmountTaxStatus amountTaxStatus;
    # The custom fields and their values for the item
    ItemCustomFieldValueInput[]? customFields?;
    # The item code
    string? itemCode?;
    # The name of the item
    @constraint:String {maxLength: 100, minLength: 1}
    string name;
    # The parent item if there is one
    string? parentItem?;
    # Details for the item when it is purchased
    ItemUseInput? purchase?;
    # The item inventory opening balance details
    ItemInventoryOpeningBalanceInput? inventoryOpeningBalance?;
    # The item inventory details
    ItemInventoryInput? inventory?;
    # The item status
    ItemStatus? status = "Active";
|};

# Represents the Queries record for the operation: listTransactionActionDetails
public type ListTransactionActionDetailsQueries record {
    # The row type to keep, or omitted for all of them
    RowType rowType?;
    # The item types to keep, or omitted for all of them
    ItemType[]? itemTypes?;
    # Text to match rows against, or omitted to match everything
    string? search?;
    # How many rows the page holds, or omitted for the action's own default
    int:Signed32? perPage?;
    # The contact's id
    string contactId?;
    # How to order the rows, as comma separated `field direction` clauses, or omitted for the action's own ranking
    string? orderby?;
    # The page to return, counting from one
    int:Signed32 page = 1;
};

# Reference to a recurring template
public type RecurringTemplateRef record {|
    # The unique name
    string? name?;
    # The unique id
    string? id?;
|};

# Details of a ledger account to create
public type LedgerAccountInput record {|
    # The parent ledger account if there is one
    string? parentLedgerAccount?;
    # The bank account details - **only** when the `accountType` is `CurrentAsset_Bank`
    LedgerAccountBankInput? bankAccount?;
    # The export code for the account
    string? exportCode?;
    # The account code
    string? accountCode?;
    # The credit account details - **only** when the `accountType` is `CurrentLiability_CreditCard`
    LedgerAccountCreditInput? creditAccount?;
    # The default tax rate for the account
    string? defaultTaxRate?;
    # The order in which the user would like to sort the account relative to other accounts
    int:Signed32? sortOrder = 0;
    # The account type
    LedgerAccountType accountType;
    # The name of the account
    @constraint:String {maxLength: 260, minLength: 1}
    string name;
    # The account cashflow classification. This is optional
    CashflowClassification? cashflowClassification = "None";
    # The description of the account
    string? description?;
    # The account status
    LedgerAccountStatus? status = "Active";
|};

