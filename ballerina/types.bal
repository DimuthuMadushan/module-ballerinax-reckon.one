    # This must be omitted if `accountDetails` have been provided
    InvoiceLineItemItemDetailsInput? itemDetails?;
    # The description of the line
    string? description?;
    # Parent id of line item if RowType is set to Data
    string? parentLineId?;
    # The id or full name of the classification that the line item relates to.
    # Note that the full name includes the name(s) of any parent classification(s) separated by colons
    string? classification?;
    # Whether the line item is a full width description only item
    boolean? isFullWidthDescription?;
    # The tax rate
    string? taxRate?;
    # Row type of line item
    LineItemRowTypeEnum? rowType?;
    # Details of an account used on an invoice line item.
    # This must be omitted if `itemDetails` have been provided
    InvoiceLineItemAccountDetailsInput? accountDetails?;
    # The line number
    int:Signed32 lineNumber;
    # The tax amount
    decimal? taxAmount?;
    # Details of transactions that are linked to the invoice
    InvoiceLineItemTransactionLink[]? transactionLinks?;
    # Grup details when RowType is set to Group
    InvoiceLineItemGroupInput? group?;
|};

# Basic business details to patch
public type GeneralDetailPatch record {|
    # The name of the company that appears on legal documents
    string? legalName?;
    # The branch number associated with the tax number
    string? branchNumber?;
    # The company's business/trading name
    string? companyName?;
    # The tax number of the company, for example, 'ABN/WPN' for AU and 'GST/IRD number' for NZ
    string? taxNumber?;
    # The business number of the company, for example, New Zealand Business Number (NZBN)
    string? businessNumber?;
    # Whether the company is a registered WHM employer
    boolean isRegisteredEmployerOfWHM?;
|};

# Represents the Queries record for the operation: listPaymentTerms
public type ListPaymentTermsQueries record {
    # The number of payment term per page
    int:Signed32? perPage = 0;
    # The page to retrieve
    int:Signed32 page = 1;
};

# A contact
public type Contact record {|
    # List of addresses
    Address[]? addresses?;
    # Notes for the contact
    string? notes?;
    # The last modified date and time of the contact
    string lastModifiedDateTime?;
    # The organisation that the contact is associated with
    OrganisationRef? organisation?;
    # The creation date and time of the contact
    string createdDateTime?;
    # List of electronic addresses
    ElectronicAddress[]? electronicAddresses?;
    # List of phone numbers
    PhoneNumber[]? phoneNumbers?;
    # The contact's display name
    string name?;
    # The contact's unique id
    string id?;
    # The salutation to use in communications
    string? salutation?;
    # The contact's position
    string? position?;
    # The contact's department
    string? department?;
    # The contact's status
    ContactStatus status?;
|};

# A book's status
public type BookStatus "Active"|"Inactive";

# Represents the Queries record for the operation: modifyLedgerAccount
public type ModifyLedgerAccountQueries record {
    # The external book/file/tenancy/etc's id
    @http:Query {name: "ExternalTenancyId"}
    string? externalTenancyId?;
    # The external resource's id
    @http:Query {name: "ExternalResourceId"}
    string? externalResourceId?;
    # The external client application's id
    @http:Query {name: "ExternalClientId"}
    string externalClientId?;
};

# A list of financial institutions
public type FinancialInstitutions record {|
    # The list of items
    FinancialInstitution[]? list?;
|};

# Details of an journal line item to create or update
public type JournalLineItemInput record {|
    # The type of transaction
    TransactionTypeInput? transactionType?;
    # The id or name of the tax rate
    string? taxRate?;
    # Notes
    string? notes?;
    # The reconciliation status.
    # Note that this can only be changed between Cleared and Uncleared
    ReconciliationStatus? reconciliationStatus = "Uncleared";
    # The id or full name of the ledger account.
    # Note that the full name includes the name(s) of any parent ledger account(s) separated by colons
    @constraint:String {minLength: 1}
    string ledgerAccount;
    # The id or full name of the project.
    # Note that the full name includes the name(s) of any parent project(s) separated by colons
    string? project?;
    # The debit amount
    decimal? debit?;
    # The credit amount
    decimal? credit?;
    # The tax amount
    decimal? taxAmount?;
    # The id or name of the classification
    string? classification?;
    # The entity (customer/supplier/superfund/employee)
    string? entity?;
|};

# Represents the Queries record for the operation: listPayTemplateAllowances
public type ListPayTemplateAllowancesQueries record {
    # The number of pay template allowances per page
    int:Signed32? perPage = 0;
    # The page to retrieve
    int:Signed32 page = 1;
};

# Details of a phone type to create or update
public type PhoneTypeInput record {|
    # The type's name
    @constraint:String {maxLength: 25, minLength: 1}
    string name;
    # The type's description
    string? description?;
    # The type's status
    TypeStatus? status = "Active";
|};
