# Represents the Queries record for the operation: createItem
public type CreateItemQueries record {
    # The external book/file/tenancy/etc's id
    @http:Query {name: "ExternalTenancyId"}
    string? externalTenancyId?;
    # The external resource's id
    @http:Query {name: "ExternalResourceId"}
    string? externalResourceId?;
    # The external client application's id
    @http:Query {name: "ExternalClientId"}
    string externalClientId?;
};

# A response that contains the resource's id
public type IdIntResponse record {|
    # The resource's id as integer. 
    int:Signed32 id?;
|};

# Represents the Queries record for the operation: listSalesOrders
public type ListSalesOrdersQueries record {
    # The number of sales orders per page
    int:Signed32? perPage = 0;
    # The page to retrieve
    int:Signed32 page = 1;
};

# Represents the patch model for an invoice attachment
public type InvoiceAttachmentPatch record {|
    # Whether the attachment is shareable
    boolean? isShareable?;
|};

# Represents the Queries record for the operation: listTemplates
public type ListTemplatesQueries record {
    # The number of super funds per page
    int:Signed32? perPage = 0;
    # The page to retrieve
    int:Signed32 page = 1;
};

# A book's report settings
public type ReportSettings record {|
    # The tax reporting basis type
    AccountingMethodType reportBasis?;
    # A book's report user settings
    ReportUserSettings? pdfSetup?;
    # The ageing report type
    AgeingReportType reportAgeingBasis?;
|};

# Details of an estimate template
public type EstimateTemplate record {|
    # The footer details of the template
    EstimateTemplateFooter footer?;
    # The template's name
    string name?;
    # The template's options flag
    int? options?;
    # The header details of the template
    EstimateTemplateHeader header?;
    # The template's font size
    float fontSize?;
    # The template's id
    string id?;
    # The content's details of the template
    EstimateTemplateContent content?;
    # The template's font
    string? font?;
|};

# Details of a ledger account to patch
public type LedgerAccountPatch record {|
    # The parent ledger account if there is one
    string? parentLedgerAccount?;
    # The bank account details - **only** when the `accountType` is `CurrentAsset_Bank`
    LedgerAccountBankPatch? bankAccount?;
    # The export code for the account
    string? exportCode?;
    # The account code
    string? accountCode?;
    # The credit account details - **only** when the `accountType` is `CurrentLiability_CreditCard`
    LedgerAccountCreditPatch? creditAccount?;
    # The default tax rate for the account
    string? defaultTaxRate?;
    # The order in which the user would like to sort the account relative to other accounts
    int:Signed32? sortOrder?;
    # The name of the account
    string? name?;
    # The account cashflow classification. 
    CashflowClassification? cashflowClassification?;
    # The description of the account
    string? description?;
    # The account status
    LedgerAccountStatus? status?;
|};

# Reference to a supplier
public type SupplierRef record {|
    # The unique name
    string? name?;
    # The unique id
    string? id?;
|};

# Details of an account used on a payment line item
public type PaymentLineItemAccountDetails record {|
    # The amount
    decimal? amount?;
    # The quantity sold
    decimal? quantity?;
    # The id and full name of the ledger account that the line relates to
    LedgerAccountRef ledgerAccount?;
|};

# A list of industries
public type Industries record {|
    # The list of items
    Industry[]? list?;
|};

# Represents the Queries record for the operation: getPayrollDetailReportWithBody
public type GetPayrollDetailReportWithBodyQueries record {
    # Whether the result is for download. If true, a ContentDisposition header will be added
    boolean download = true;
    # The format to use, e.g. pdf
    string? format?;
    # The report parameters
    PayrollDetailReportParameters parameters?;
};

# The type of a recurring transaction. The values match the domain recurring transaction type
public type RecurringTransactionType "Invoice"|"Bill"|"Payment"|"Receipt"|"Journal";

# Periods that can be used for the Payroll Leave Balances And Accrual Value report
public type PayrollLeaveBalancesAndAccrualValueReportPeriod "AsAtDate";

# Model for creating a new bill
public type BillInput record {|
    # The bill reference
    string? reference?;
    # The template used to print or email the bill
    string? template?;
    # The individual items that make up the bill
    BillLineItemInput[] lineItems;
    # The bill discount percentage
    decimal? billDiscountPercent?;
    # Notes related to the bill
    string? notes?;
    # The bill discount amount
    decimal? billDiscountAmount?;
    # The amount tax status of the amounts in the bill
    AmountTaxStatus amountTaxStatus;
    # The supplier that is being billed
    @constraint:String {minLength: 1}
    string supplier;
    # The date bill is due by
    string? dueDate?;
    # The date of the bill
    @constraint:String {minLength: 1}
    string billDate;
    # The classification
    string? classification?;
|};

public type TransactionActionType "Unknown"|"InvoiceSalesOrders"|"InvoiceTimeEntriesAndExpenses"|"InvoiceRecurringTransactions"|"InvoiceRecentTransactions"|"InvoiceFrequentlyUsed";

# A list of bank payments
public type BankPayments record {|
    # The list of items
    BankPayment[]? list?;
|};

# The book's tax email settings
public type EmailSettings record {|
    # BAS default email settings
    EmailTemplate? bas?;
|};

# Payslip settings to patch
public type PayslipSettingsPatch record {|
    # Email settings
    EmailTemplatePatch? emailSettings?;
|};

# A document attachment
public type DocumentAttachment record {|
    # Size of the document
    int:Signed32? fileSize?;
    # The attachment's name or file name
    string name?;
    # Indicates whether document can be shared with external parties
    boolean? isShareable?;
    # The attachment's unique id
    string id?;
    # The URL to use to retrieve the attachment
    string url?;
|};

# A list of enterprise agreements
public type EnterpriseAgreements record {|
    # The list of items
    EnterpriseAgreement[]? list?;
|};

# Details of an account used on an bill line item
public type BillLineItemAccountDetailsInput record {|
    # The amount including or excluding tax (depending on the `amountTaxStatus`)
    decimal? amount = 0;
    # The quantity purchased
    decimal? quantity?;
    # The id or full name of the ledger account that the line relates to.
    # Note that the full name includes the name(s) of any parent account(s) separated by colons
    @constraint:String {minLength: 1}
    string ledgerAccount;
|};

# Details of an electronic address type
public type ElectronicAddressType record {|
    # The last modified UTC date time
    string lastModifiedDateTime?;
    # The type's name
    string name?;
    # The type's description
    string? description?;
    # The creation UTC date time
    string createdDateTime?;
    # The type's id
    string id?;
    # Whether this is a default type for a contact
    boolean contactDefault?;
    # Whether this is a default type for an organisation (customer, supplier or super fund)
    boolean organisationDefault?;
    # The type's status
    TypeStatus status?;
|};

# Details of a payment to update
public type PaymentPatch record {|
    # The payment reference
    string? reference?;
    # The total amount of the bill
    decimal totalAmount?;
    # Notes related to the payment
    string? notes?;
    # The payment's reconciliation status.
    # Note that this can only be initially set to Cleared or Uncleared and that it can only be updated via a bank reconciliation
    ReconciliationStatus? reconciliationStatus?;
    # The id or name of the bank/cash/credit account where the money was withdrawn
    string? ledgerAccount?;
    # The supplier
    string? supplier?;
    # The id or name of the payment method used
    string? paymentMethod?;
    # Internal Notes related to the payment
    string? internalNotes?;
    # The date of the payment
    string? paymentDate?;
    # The classification
    string? classification?;
|};

# Leave balance totals
public type PayrollLeaveBalancesAndAccrualValueReportTotals record {|
    # The total value
    decimal totalValue?;
    # The leave balance
    decimal leaveBalance?;
    # The ordinary time earnings value
    decimal oteValue?;
    # The leave loading currency value
    decimal leaveLoadingValue?;
|};

# Reconciliation status
public type ReconciliationStatus "Uncleared"|"Cleared"|"Reconciled";

# Details of a ledger account
public type LedgerAccount record {|
    # The parent ledger account if there is one
    LedgerAccountRef? parentLedgerAccount?;
    # The bank account details when the `accountType` is `CurrentAsset_Bank`
    BankAccount? bankAccount?;
    # The account code
    string? accountCode?;
    # The credit account details when the `accountType` is `CurrentLiability_CreditCard`
    CreditAccount? creditAccount?;
    # The date and time when the account was last modified
    string lastModifiedDateTime?;
    # The default tax rate for the account
    TaxRef? defaultTaxRate?;
    # The account type
    LedgerAccountType accountType?;
    # The cashflow classification of the account
    CashflowClassification cashflowClassification?;
    # The description of the account
    string description?;
    # The full name of the account
    string fullName?;
    # The export code for the account
    string? exportCode?;
    # The account's balance as of now
    decimal? balance?;
    # The accounting-category-level sort order. Applies across all ledger accounts within the book; does not take the book's BankAccountSortPolicy into account.
    # For ordering bank/credit accounts in a list driven by the sort policy, use bankAccountSortOrder instead
    int:Signed32 sortOrder?;
    # The name of the account
    string name?;
    # The account's system category. Null when the read that produced this account does not set it
    # (the tax reads nest an account without one)
    LedgerAccountSystemCategoryGraphqlEnum? systemCategory?;
    # The account's unique id
    string id?;
    # Whether amounts in this account are usually debits
    boolean isDebit?;
    # Whether account is categorised as System or not
    boolean systemAccount?;
    # Details of any external client resource
    ExternalClientResource? externalClient?;
    # The account status
    LedgerAccountStatus status?;
|};

# A list of a superstream unlinked payruns
public type SuperstreamUnlinkedPayruns record {|
    # The list of items
    SuperstreamUnlinkedPayrun[]? list?;
|};

# A book's report settings
public type ReportSettingsPatch record {|
    # The tax reporting basis type
    AccountingMethodType reportBasis?;
    # A book's report user settings
    ReportUserSettingsPatch? pdfSetup?;
    # The ageing report type
    AgeingReportType reportAgeingBasis?;
|};

# Details of an item used on an bill line item
public type BillLineItemItemDetails record {|
    # The id and full name of the item that the line relates to
    ItemRef item?;
    # The quantity sold
    decimal? quantity?;
    # The discount percentage for the line item
    decimal? discountPercent?;
    # The price of each item
    decimal? price?;
    # The total discount for the line item
    decimal? discountAmount?;
|};

# Details of an estimate to create
public type EstimateInput record {|
    # The estimate reference
    string? reference?;
    # The id or name of the template used to print or email the estimate
    @constraint:String {minLength: 1}
    string template;
    # The individual items that make up the estimate
    EstimateLineItemInput[] lineItems;
    # Notes related to the estimate
    string? notes?;
    # Payment notes
    string? paymentNotes?;
    # The amount tax status of the amounts in the estimate
    AmountTaxStatus amountTaxStatus;
    # Gets or sets the unique identifier for the estimate
    string? estimateNumber?;
    # The date the estimate expires on
    string? estimateExpiryDate?;
    # The id or name of the classification
    string? classification?;
    # The id or name of the customer that is being quoted
    @constraint:String {minLength: 1}
    string customer;
    # The date of the estimate
    @constraint:String {minLength: 1}
    string estimateDate;
    # Terms and conditions
    string? termsAndConditions?;
|};

# A supplier
public type Supplier record {|
    # List of addresses
    Address[]? addresses?;
    # The organisation's notes
    string? notes?;
    # The organisation's last modified date
    string lastModifiedDateTime?;
    # This applies to NZBN number
    string? businessNumber?;
    # List of electronic addresses
    ElectronicAddress[]? electronicAddresses?;
    # The organisation's branch
    string? branch?;
    # List of phone numbers
    PhoneNumber[]? phoneNumbers?;
    # Indicates whether the supplier is also a customer
    boolean? isCustomer?;
    # The supplier's bank account details
    SupplierBankDetails? bankDetails?;
    # The organisation's name
    string? organisationName?;
    # The organisation's current balance
    decimal? balance?;
    # The organisation's display name
    string name?;
    # The total number of overdue bills that have been received from the organisation
    int:Signed32? overdueBillCount?;
    # The credit limit held against the contact when it is also a customer (null otherwise)
    decimal? creditLimit?;
    # The organisation's business number 2
    string? businessNumber2?;
    # The organisation's entity types
    EntityType entityTypes?;
    # The organisation's unique id
    string id?;
    # The organisation's business number 1
    string? businessNumber1?;
    # Details of any external client resource
    ExternalClientResource? externalClient?;
    # The organisation's contacts list
    ContactRef[]? contacts?;
    # If the supplier is Tpar (null for other types)
    boolean? isTpar?;
    # The payment term held against the contact when it is also a customer (null otherwise).
    # Exposed on the GraphQL schema by the reckon-graphql subgraph (as the rich PaymentTerm type),
    # so it is ignored here to avoid a federation type conflict; it remains in the REST payload
    PaymentTermRef? paymentTerms?;
    # The organisation's status (Active or Inactive)
    OrganisationStatus status?;
|};

# Details of an expense claim line item to create
public type ExpenseClaimLineItemInput record {|
    # The date of the line item
    @constraint:String {minLength: 1}
    string date;
    # Notes relating to the expense
    string? notes?;
    # Whether the tax amount has been modified
    boolean? taxIsModified = false;
    # The id or full name of the project that the line item relates to.
    # Note that the full name includes the name(s) of any parent project(s) separated by colons
    string? project?;
    # Details of an item used on an expense claim line item.
    # This must be omitted if `accountDetails` have been provided
    ExpenseClaimLineItemItemDetailsInput? itemDetails?;
    # The description of the expense
    string? description?;
    # The billable status of the line item
    BillableStatus? billableStatus = "Unbillable";
    # The classification
    string? classification?;
    # Whether the line item is billable to the customer or project
    boolean? isBillable = false;
    # The tax rate
    string? taxRate?;
    # Details of an account used on an expense claim line item.
    # This must be omitted if `itemDetails` have been provided
    ExpenseClaimLineItemAccountDetailsInput? accountDetails?;
    # The supplier that the line item relates to
    string? supplier?;
    # The line number
    int:Signed32 lineNumber;
    # The tax amount
    decimal? taxAmount?;
    # The customer that the line item relates to
    string? customer?;
|};

# Details of a classification to create or update
public type ClassificationInput record {|
    # Whether the classification is the default for the transaction
    boolean? isDefault = false;
    # The parent classification if there is one
    string? parentClassification?;
    # The classification's name
    @constraint:String {maxLength: 50, minLength: 1}
    string name;
    # The classification's description
    string? description?;
    # Active/Inactive status of the classification
    ClassificationStatus? status = "Active";
|};

# Details of a project item to create or update
public type ProjectItemInput record {|
    # Rate at which item is charged for this project
    decimal? projectRate?;
    # The id or name of the item
    @constraint:String {minLength: 1}
    string item;
|};

# Pay template classification input
public type PayTemplateClassificationInput record {|
    # Rate type
    RateType rateType?;
    # Casual amount
    decimal? casualAmount?;
    # Pay template enterprise agreement classification
    string? agreementClassification?;
    # Pay template award classification
    string? awardClassification?;
    # Fulltime amount
    decimal fullTimeAmount?;
    # Casual percentage
    decimal? casualPercentage?;
|};

# The current API status
public type HeartbeatStatus record {|
    # Current environment
    string? environment?;
    # Current Git Version
    GitVersion? gitVersion?;
    # The description of the API
    string? description?;
    # The current API version
    string? version?;
    # The status of the API
    string? status?;
|};

# Common role permissions plus approve and manage actions
public type RolePermissionsWithApproveManage record {|
    # Whether the role has permission to view
    boolean view?;
    # Whether the role has permission to edit/update/modify
    boolean edit?;
    # Whether the role has permission to approve
    boolean approve?;
    # Whether the role has permission to create
    boolean create?;
    # Whether the role has permission to delete
    boolean delete?;
    # Whether the role has permission to manage
    boolean manage?;
|};

# The status of an estimate
public type EstimateStatus "Draft"|"Pending"|"Accepted"|"Declined"|"ClosedDeclined"|"ClosedInvoiced";

# Represents the Queries record for the operation: listTaxGroupsOnDate
public type ListTaxGroupsOnDateQueries record {
    # The number of groups per page
    int:Signed32? perPage = 0;
    # The page to retrieve
    int:Signed32 page = 1;
};

# Type of transaction linked to an invoice or bill
public type LinkedTransactionType "Estimate"|"Expense"|"Timesheet"|"Receipt"|"CreditNote"|"Payment"|"Invoice"|"Journal"|"Bill"|"PayRun"|"ReversedJournal"|"ReversalJournal"|"BankPayment"|"SupplierCreditNote"|"ExpenseLineItem"|"JournalLineItem"|"BillLineItem"|"PurchaseOrderLineItem"|"JournalEntryPayable"|"JournalEntryReceivable";

# Represents the Queries record for the operation: listEntities
public type ListEntitiesQueries record {
    # The number of entities per page
    int:Signed32? perPage = 0;
    # The page to retrieve
    int:Signed32 page = 1;
};

# A list of entities
public type Entities record {|
    # The list of items
    Entity[]? list?;
|};

# What the transaction actions on a transaction form have to offer for one contact
public type TransactionActionsSummary record {|
    # How many actions are available, for the actions button's label
    int:Signed32 actionCount?;
    # The actions, in the order they are presented
    TransactionAction[]? actions?;
|};

# Details of an estimate to patch
public type EstimatePatch record {|
    # The estimate reference
    string? reference?;
    # The id or name of the template used to print or email the estimate
    string? template?;
    # Notes related to the estimate
    string? notes?;
    # Payment notes
    string? paymentNotes?;
    # The amount tax status of the amounts in the estimate
    AmountTaxStatus? amountTaxStatus?;
    # The date the estimate expires on
    string? estimateExpiryDate?;
    # The id or name of the classification
    string? classification?;
    # The id or name of the customer that is being quoted
    string? customer?;
    # The date of the estimate
    string? estimateDate?;
    # The status of the estimate
    EstimateStatus? status?;
    # Terms and conditions
    string? termsAndConditions?;
|};

# A receipt line item
public type ReceiptLineItem record {|
    # The tax rate
    TaxRateRef? taxRate?;
    # Details of an account used on a receipt line item
    ReceiptLineItemAccountDetails? accountDetails?;
    # The line item's unique id
    string lineId?;
    # The id and full name of the project that the line item relates to
    ProjectRef? project?;
    # Details of an item used on a receipt line item
    ReceiptLineItemItemDetails? itemDetails?;
    # The description of the item
    string? description?;
    # The line number
    int:Signed32 lineNumber?;
    # The tax amount
    decimal? taxAmount?;
    # The classification
    ClassificationRef? classification?;
|};

# Represents the Queries record for the operation: getCreditNote
public type GetCreditNoteQueries record {
    # The format to use, e.g. pdf
    string? format?;
};

# A purchase order
public type PurchaseOrder record {|
    # The template used to print or email the purchase order
    TemplateRef? template?;
    # The amount of the purchase order that has been billed (total amount less outstanding balance)
    decimal totalBilled?;
    # Notes related to the purchase order
    string? notes?;
    # The date the purchase order was last modified. UTC date-time in ISO-8601 format
    string? lastModifiedDateTime?;
    # Document attachments related to the purchase order
    DocumentAttachment[]? attachments?;
    # The amount tax status of the amounts in the purchase order
    AmountTaxStatus amountTaxStatus?;
    # The project
    ProjectRef? project?;
    # The date the purchase order was created. UTC date-time in ISO-8601 format
    string? createdDateTime?;
    # The purchase order reference
    string? reference?;
    # The individual items that make up the purchase order
    PurchaseOrderLineItem[] lineItems?;
    # The date of the purchase order
    string purchaseOrderDate?;
    # The delivery address of the purchase order
    string? deliveryAddress?;
    # The supplier that owns the purchase order
    ContactRef supplier?;
    # Identifies if purchase order has linked bills
    boolean hasLinkedBills?;
    # The purchase order's unique id
    string id?;
    # The expiry date of purchase order
    string? deliveryDate?;
    # The outstanding balance of the purchase order
    decimal totalBalance?;
    # The last email store id purchase order got sent
    string? lastEmailStoreId?;
    # The classification
    ClassificationRef? classification?;
    # The total amount of the purchase order
    decimal totalAmount?;
    # Whether the purchase order has been emailed to the supplier
    EmailStatus emailStatus?;
    # The purchase order's number
    string purchaseOrderNumber?;
    # The last date and item purchase order got sent
    string? sendDateTimeUTC?;
    # The address that the invoice was sent to
    Address? billingAddress?;
    # The total tax amount of the purchase order
    decimal totalTaxAmount?;
    # The status of the purchase order
    PurchaseOrderStatus status?;
|};

# Reference to a template
public type TemplateRef record {|
    # The unique name
    string? name?;
    # The unique id
    string? id?;
|};

# Reference to an address type
public type AddressTypeRef record {|
    # The unique name
    string? name?;
    # The unique id
    string? id?;
|};

# The ledger account type
public type LedgerAccountType "Income"|"Expense"|"CurrentAsset_Other"|"CurrentLiability_Other"|"Equity"|"Income_Other"|"Expense_Other"|"Expense_CostOfGoodsSold"|"CurrentAsset_Bank"|"CurrentAsset_AccountsReceivable"|"NonCurrentAsset_Fixed"|"NonCurrentAsset_Other"|"CurrentLiability_CreditCard"|"CurrentLiability_AccountsPayable"|"NonCurrentLiability";

# Details of a project supplier to create or update
public type ProjectSupplierInput record {|
    # The id or name of the supplier
    @constraint:String {minLength: 1}
    string supplier;
    # Weighting assigned to contact
    decimal? weighting = 100;
|};

# A list of pay template earnings
public type PayTemplateEarnings record {|
    # The list of items
    PayTemplateEarning[]? list?;
|};

# Bill settings to patch
public type BillSettingsPatch record {|
    # The bill prefix
    string? prefix?;
    # Email settings
    EmailTemplatePatch? emailSettings?;
    # The default bill template
    string? defaultTemplate?;
    # Indicates whether bill approval process is enabled
    boolean approvalEnabled?;
|};

# Details of an expense claim line item to patch
public type ExpenseClaimLineItemPatch record {|
    # The date of the line item
    string? date?;
    # Notes relating to the expense
    string? notes?;
    # Whether the tax amount has been modified
    boolean? taxIsModified?;
    # The id or full name of the project that the line item relates to.
    # Note that the full name includes the name(s) of any parent project(s) separated by colons
    string? project?;
    # Details of an item used on an expense claim line item.
    # This must be omitted if `accountDetails` have been provided
    ExpenseClaimLineItemItemDetailsPatch? itemDetails?;
    # The description of the expense
    string? description?;
    # The billable status of the line item
    BillableStatus? billableStatus?;
    # The classification
    string? classification?;
    # Whether the line item is billable to the customer
    boolean? isBillable?;
    # The tax rate
    string? taxRate?;
    # Details of an account used on an expense claim line item.
    # This must be omitted if `itemDetails` have been provided
    ExpenseClaimLineItemAccountDetailsPatch? accountDetails?;
    # The supplier that the line item relates to
    string? supplier?;
    # The line number
    int:Signed32? lineNumber?;
    # The tax amount
    decimal? taxAmount?;
    # The customer that the line item relates to
    string? customer?;
|};

