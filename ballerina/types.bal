# The parameters for the super contributions by employee report
public type SuperContributionsByEmployeeReportParameters record {|
    # The 'from' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? fromDate?;
    # A list of pay run IDs to include in the report.
    # If omitted, all pay runs will be included
    string[]? payRuns?;
    # The period
    SuperContributionsByEmployeeReportPeriod? period = "AllDates";
    # The report's orientation
    ReportOrientation? orientation = "Portrait";
    # A list of columns to include in the report.
    # If omitted, all columns will be returned
    SuperContributionsByEmployeeReportColumn[]? columns?;
    # The 'to' date for the report.
    # Only required if `period` is `SpecifiedDates`
    string? toDate?;
    # The payrun statuses to include in the report
    SuperContributionsByEmployeeReportPayrunStatus payrunStatus;
    # A list of employee IDs to include in the report.
    # If omitted, all employees will be included
    string[]? employees?;
    # A list of super fund product IDs to include in the report.
    # If omitted, all super fund products will be included
    string[]? superFundProducts?;
    # An authentication token. Note that this is not required if it is supplied via the HTTP `Authorize` header
    string? token?;
|};

