    # The date of the sales order
    @constraint:String {minLength: 1}
    string salesOrderDate;
    # The amount tax status of the amounts in the sales order
    AmountTaxStatus amountTaxStatus;
    # The project
    string? project?;
    # The payment details ("how to pay") shown on the sales order
    string? paymentDetails?;
    # The classification
    string? classification?;
    # The customer's purchase order number
    string? customerPurchaseOrderNumber?;
    # The customer for the sales order
    @constraint:String {minLength: 1}
    string customer;
|};

# Details of a receipt line item to update
public type ReceiptLineItemPatch record {|
    # The tax rate
    string? taxRate?;
    # Details of an account used on an receipt line item.
    # This must be omitted if `itemDetails` have been provided
    ReceiptLineItemAccountDetailsPatch? accountDetails?;
    # The id or full name of the project that the line item relates to.
    # Note that the full name includes the name(s) of any parent project(s) separated by colons
    string? project?;
    # Details of an item used on an receipt line item.
    # This must be omitted if `accountDetails` have been provided
    ReceiptLineItemItemDetailsPatch? itemDetails?;
    # The description of the line
    string? description?;
    # The line number
    int:Signed32? lineNumber?;
    # The tax amount
    decimal? taxAmount?;
    # The classification
    string? classification?;
|};

public type BatchProcessingStatus "Invalid"|"Complete";

# A list of a super fund provider's products
public type SuperfundProviderProducts record {|
    # The list of items
    SuperfundProviderProduct[]? list?;
|};

# Manager belonging to department
public type DepartmentManagerInput record {|
    # A manager's Id
    string id?;
|};

# Details of a time entry to patch
public type TimeEntryPatch record {|
    # The time entry's approval status
    TimeEntryApprovalStatus approvalStatus?;
    # The id or full name of the item that the time entry relates to.
    # Note that the full name includes the name(s) of any parent item(s) separated by colons
    string? item?;
    # Notes related to the time entry
    string? notes?;
    # The id or full name of the project on which the time was spent on.
    # Note that the full name includes the name(s) of any parent project(s) separated by colons
    string? project?;
    # Details of the time spent
    TimeDetailsPatch? time?;
    # The id or name of the employee that spent the time
    string? employee?;
    # The id or name of the classification
    string? classification?;
    # The id or full name of the payroll pay item that the time entry relates to
    string? payrollItem?;
    # Whether the time can be billed to a customer
    boolean? billable?;
    # Date of the time entry
    string timeEntryDate?;
    # Reason why time entry approval was declined
    string? declineReason?;
    # The id or name of the customer for whom the time was spent on
    string? customer?;
|};

# Payroll Detail report - details of a transaction
public type PayrollDetailItem record {|
    # The total amount (e.g. Quantity x Rate)
    decimal amount?;
    # The quantity (e.g. number of hours worked)
    decimal? quantity?;
    # The rate (e.g. pay per hour)
    decimal? rate?;
    # The item's name
    string name?;
    # The project's name
    string? project?;
    # Date range for this item
    string? dates?;
    # The customer's name
    string? customer?;
|};

# Represents the input data for a stock adjustment operation, including the line items to be adjusted
public type StockAdjustmentInput record {|
    # Line items used in the stock adjustment
    StockAdjustmentLineItemInput[]? lineItems?;
    # Gets or sets the date on which the adjustment is applied
    string adjustmentDate?;
    # Gets or sets the type of stock adjustment being performed
    StockAdjustmentType adjustmentType?;
    # The description of the stock adjustment
    string? description?;
    # The classification
    string? classification?;
    # Gets or sets the bank account associated with the operation
    string? account?;
|};

# Payroll Detail report - details of a pay run
public type PayrollDetailPayRun record {|
    # The date of the pay run payment
    string paymentDate?;
    # Employees included in the pay run
    PayrollDetailEmployee[] employees?;
    # The pay run
    PayRunRef payRun?;
|};

# Details on how to contact the business to update
public type ContactDetailInput record {|
    # Name of person who is primary contact within the business
    string? contactName?;
    # List of electronic addresses
    BookElectronicAddressInput[] electronicAddresses;
    # List of phone numbers
    BookPhoneNumberInput[] phoneNumbers;
|};

# Details of a book's general settings to patch
public type BookSettingsPatch record {|
    # Transactions on or before this date cannot be changed
    string? lockOffDate?;
    # The email address used by clients when replying to emails sent from Reckon One
    string? replyToEmailAddress?;
    # The displayed name of sender in emails
    string? showEmailSentFrom?;
    # The number of most recent days bank data is retrieved for
    int:Signed32? bankDataRetrievalDays?;
    # The id or name of the industry of business
    string? industry?;
    # General company details
    GeneralDetailPatch? generalDetails?;
    # The id or name of the industry's category of business
    string? category?;
    # The id or name of the industry category's business type
    string? businessType?;
    # Business's contact details
    ContactDetailPatch? contactDetails?;
    # The first day of records for the book
    string? startDate?;
    # The id or name of the entity type of business
    string? entity?;
|};

# Item usage details
public type ItemUseInput record {|
    # The tax rate
    string? taxRate?;
    # The ledger account
    @constraint:String {minLength: 1}
    string ledgerAccount;
    # The item's price.
    # If the item's `amountTaxStatus` is `Inclusive` then the price includes tax (gross).
    # If the item's `amountTaxStatus` is `Exclusive` then the price excludes tax (net)
    decimal? price?;
    # The description
    string? description?;
    # The accuracy (number of decimal places) of the price
    int? priceAccuracy?;
|};

# An entity
public type Entity record {|
    # The entity's financial year default start month. 
    int:Signed32 defaultStartMonth?;
    # The country
    EntityCountry? country?;
    # The entity's display name. 
    string? description?;
    # The entity's unique id
    string id?;
    # The entity has industry type. 
    boolean hasIndustryType?;
    # The entity's display name. 
    string? entityNameLabel?;
    # The entity's financial year default start day. 
    int:Signed32 defaultStartDay?;
|};

# An address to patch
public type BookAddressPatch record {|
    # Country of address
    string? country?;
    # Town of address
    string? town?;
    # Postcode of address
    string? postcode?;
    # Suburb of address
    string? suburb?;
    # State of address
    string? state?;
    # Third line of address
    string? line3?;
    # Second line of address
    string? line2?;
    # First line of address
    string? line1?;
|};

# Details of a superfund to create or update
public type SuperfundDetails record {|
    # Is the default super fund for the book
    boolean isDefaultFundEntity?;
    # The superfund provider details
    SuperfundProvider2? superfundProvider?;
    # The SMSF provider details
    SelfManagedSuperfund? smsf?;
|};

# A customer
public type Customer record {|
    # List of addresses
    Address[]? addresses?;
    # The organisation's notes
    string? notes?;
    # The organisation's last modified date
    string lastModifiedDateTime?;
    # The list of custom field values for the customer
    CustomFieldValue[]? customFields?;
    # List of electronic addresses
    ElectronicAddress[]? electronicAddresses?;
    # The organisation's branch
    string? branch?;
    # List of phone numbers
    PhoneNumber[]? phoneNumbers?;
    # The bank account details held against the contact when it is also a supplier (null otherwise)
    SupplierBankDetails? bankDetails?;
    # Indicates that the invoice reminder has been excluded for invoices
    boolean? excludeFromInvoiceReminders?;
    # The organisation's current balance
    decimal? balance?;
    # The customer's credit limit (null for other types)
    decimal? creditLimit?;
    # The organisation's business number 2
    string? businessNumber2?;
    # The organisation's entity types
    EntityType entityTypes?;
    # The organisation's unique id
    string id?;
    # The organisation's business number 1
    string? businessNumber1?;
    # Details of any external client resource
    ExternalClientResource? externalClient?;
    # If the contact is Tpar when it is also a supplier (null otherwise)
    boolean? isTpar?;
    # The customer's peyment term (null for other types)
    PaymentTermRef? paymentTerms?;
    # The total number of invoices that have been issued to the organisation
    int:Signed32? invoiceCount?;
    # This applies to NZBN number
    string? businessNumber?;
    # The organisation's name
    string? organisationName?;
    # The details of transaction password
    TransactionPassword? transactionPassword?;
    # The organisation's display name
    string name?;
    # The organisation's contacts list
    ContactRef[]? contacts?;
    # The organisation's status (Active or Inactive)
    OrganisationStatus status?;
|};

# Item usage details
public type ItemUse record {|
    # The tax rate
    TaxRateRef? taxRate?;
    # The ledger account
    LedgerAccountRef ledgerAccount?;
    # The item's price.
    # If the item's `amountTaxStatus` is `Inclusive` then the price includes tax (gross).
    # If the item's `amountTaxStatus` is `Exclusive` then the price excludes tax (net)
    decimal? price?;
    # The description
    string? description?;
    # The item's price excluding tax (net)
    decimal? priceNet?;
    # The item's price including tax (gross)
    decimal? priceGross?;
    # The accuracy (number of decimal places) of the price
    int? priceAccuracy?;
|};

# The BAS reporting period
public type BasReportingPeriodType "Monthly"|"QuarterlyOption1GstReportQuarterly"|"QuarterlyOption2GstQuarterlyReportAnnually"|"QuarterlyOption3GstInstalmentQuarterly"|"Annually";

