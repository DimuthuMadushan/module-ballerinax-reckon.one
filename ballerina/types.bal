|};

# Details of a receipt to update
public type ReceiptPut record {|
    # The accounts receivable ledger account.
    # _Note:_ It is not currently possible to create multiple Accounts Receivable accounts so this field is read-only and will be ignored
    string? accountsReceivableLedgerAccount?;
    # Notes related to the receipt
    string? notes?;
    # The date of the receipt
    @constraint:String {minLength: 1}
    string receiptDate;
    # Internal Notes related to the receipt
    string? internalNotes?;
    # The classification
    string? classification?;
    # The receipt reference
    string? reference?;
    # The individual items that make up the receipt
    ReceiptLineItemPut[]? lineItems?;
    # The total amount of the receipt
    decimal totalAmount;
    # The receipt's reconciliation status.
    # Note that this can only be changed between Cleared and Uncleared
    ReconciliationStatus? reconciliationStatus = "Uncleared";
    # The id or name of the bank/cash/credit account where the money was received
    string? ledgerAccount?;
    # The id or name of the payment method used
    string? paymentMethod?;
    # Details of transactions that the receipt should be allocated to
    ReceiptTransactionLinkInput[]? transactionLinks?;
    # The customer that is being invoiced
    @constraint:String {minLength: 1}
    string customer;
|};

# Pay template batch update earnings input.
#             
public type PayTemplateEarningsInput record {|
    # A GUID or string that maps to a PayItemsEarnings Id
    string? earningsItem?;
    # One or more classification Ids for the pay template earnings
    string[]? classifications?;
    # The full time rate for the earnings item. When provided, it must be a positive number
    decimal? rateFullTime?;
    # The casual rate for the earnings item. When provided, it must be a positive number
    decimal? rateCasual?;
    # The unique id for the earnings input.
    # For existing pay template earnings, this field is required in order to indicate a database UPDATE.
    # As such, the Id should be an existing value in the PayTemplateEarnings table.
    # If not passed, then Key is required, and would indicate a database INSERT.
    #             
    string? id?;
    # The API caller's arbitrary reference for an earnings input.
    # This is not stored in the database but returned as part of the response for the API caller's purposes.
    # If Id is not passed, then this must have a value, and would indicate a database INSERT
    string? 'key?;
|};

